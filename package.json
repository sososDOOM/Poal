{
  "name": "poal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hebrew verb conjugation practice",
  "scripts": {
    "start": "python -m http.server 8000",
    "build": "node scripts/build-verbs.mjs && node scripts/build-vowels.mjs",
    "build:standalone": "node scripts/build-standalone.mjs",
    "validate": "node scripts/validate-verbs.mjs",
    "test:engine": "node scripts/test-engine.mjs",
    "check": "node scripts/test-engine.mjs && node scripts/validate-verbs.mjs && node scripts/build-vowels.mjs --check && node scripts/test-translit.mjs && node scripts/test-english.mjs",
    "test:translit": "node scripts/test-translit.mjs",
    "test:english": "node scripts/test-english.mjs",
    "check:vowels": "node scripts/check-vowels.mjs"
  }
}
